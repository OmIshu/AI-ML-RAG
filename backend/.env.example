# ---- OCR (scanned pages / image-only pages) ----
# Datalab API key: https://www.datalab.to  (leave empty to fall back to local Tesseract)
DATALAB_API_KEY=

# ---- LLM (any OpenAI-compatible endpoint) ----
# Default: Groq free tier. Get a key at https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Local alternative (Ollama):  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1:8b

# ---- Embeddings / reranker (open-source, downloaded from HuggingFace) ----
# Fast English model. Multilingual alternative: BAAI/bge-m3 with QUERY_PREFIX= (empty) and CHUNK_TOKENS=500
EMBED_MODEL=BAAI/bge-small-en-v1.5
QUERY_PREFIX=Represent this sentence for searching relevant passages: 
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=auto

# ---- Vector DB (Qdrant, open-source) ----
# Empty QDRANT_URL => embedded local mode stored in data/qdrant (single process only).
# For API + UI at the same time run `docker compose up -d` and set http://localhost:6333
QDRANT_URL=
QDRANT_COLLECTION=pdf_chunks

# ---- Chunking ----
CHUNK_TOKENS=500
CHUNK_OVERLAP=0.15

# ---- Retrieval ----
TOP_K_CANDIDATES=15
TOP_N_CONTEXT=4
